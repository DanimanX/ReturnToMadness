; Engine configuration file.
; Regreso a la Locura — Return to Madness
; Godot 4.7

config_version=5

[application]

config/name="Regreso a la Locura"
config/version="1.0.1"
config/description="Action-platformer de horror cósmico. Siete descensos. Una sola cordura."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.015, 0.015, 0.02, 1)
boot_splash/show_image=false

[audio]

buses/default_bus_layout=""

[autoload]

GameState="*res://scripts/game_state.gd"
I18n="*res://scripts/i18n.gd"
AudioDirector="*res://scripts/audio_director.gd"
ControllerCompat="*res://scripts/controller_compat.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

